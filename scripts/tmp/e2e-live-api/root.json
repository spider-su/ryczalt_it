<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Investory</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <meta name="_csrf" content="5e25b620-b148-4a96-995b-696dd5a23c56">
    <script>
        (function () {
            function addCsrfInputs() {
                const token = document.querySelector('meta[name="_csrf"]')?.content;
                if (!token) return;
                document.querySelectorAll('form[method="post"], form[method="POST"]').forEach(function (form) {
                    if (form.querySelector('input[name="_csrf"]')) return;
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = '_csrf';
                    input.value = token;
                    form.appendChild(input);
                });
            }
            document.addEventListener('DOMContentLoaded', addCsrfInputs);
            document.addEventListener('turbo:load', addCsrfInputs);
        }());
    </script>
    <script>
        (function () {
            try {
                const saved = localStorage.getItem('investory.theme');
                const theme = saved === 'dark' || saved === 'light'
                    ? saved
                    : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.dataset.theme = theme;
                document.documentElement.dataset.bsTheme = theme;
            } catch (ignored) {
                const theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = theme;
                document.documentElement.dataset.bsTheme = theme;
            }
        }());
    </script>
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href="/css/tokens.css" rel="stylesheet">
    <link href="/css/base.css" rel="stylesheet">
    <link href="/css/components.css" rel="stylesheet">
    <!-- Hotwire Turbo Drive v8.0.23, vendored from https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-umd.js -->
    <script src="/js/turbo-8.0.23.js" data-turbo-track="reload"></script>
    <script src="/webjars/chart.js/4.4.1/dist/chart.umd.js" data-turbo-track="reload"></script>
    <script src="/js/tabler.min.js" data-turbo-track="reload"></script>
    <script type="module" src="/js/investory-navigation.js" data-turbo-track="reload"></script>
    <script>window.investoryCapabilities = {canEdit: false, canImport: false, canManageProfile: false, canManageIntegrations: false};</script>
    <script src="/js/investory-authorization.js" data-turbo-track="reload"></script>
    <script src="/js/theme.js" data-turbo-track="reload"></script>

    <style>
        .iv-hero {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
        }
        .iv-hero__card {
            width: 100%;
            max-width: 420px;
            text-align: center;
            background: var(--iv-surface);
            border: 1px solid var(--iv-border);
            border-radius: var(--iv-radius);
            box-shadow: var(--iv-shadow);
            padding: 40px 32px;
        }
        .iv-hero__logo {
            width: 64px;
            height: 64px;
            margin: 0 auto 20px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            background: linear-gradient(135deg, var(--iv-primary), var(--iv-blue));
            box-shadow: 0 10px 24px rgba(79, 70, 229, .35);
        }
        .iv-hero__title { margin: 0 0 6px; font-size: 1.6rem; font-weight: 800; letter-spacing: -.02em; }
        .iv-hero__subtitle { margin: 0 0 28px; color: var(--iv-text-muted); }
        .iv-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 13px 20px;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(135deg, var(--iv-primary), var(--iv-blue));
            box-shadow: 0 8px 20px rgba(79, 70, 229, .3);
            transition: transform .15s ease, box-shadow .15s ease;
        }
        .iv-btn:hover { transform: translateY(-2px); box-shadow: var(--iv-shadow-hover); }
    </style>
</head>
<body>
<main class="iv-hero">
    <div class="iv-hero__card">
        <div class="iv-hero__logo">I</div>
        <h1 class="iv-hero__title">Welcome to Investory</h1>
        <p class="iv-hero__subtitle">Track your portfolio performance across brokers.</p>
        <a class="iv-btn" href="/portfolios/1/dashboard">Open dashboard →</a>
    </div>
</main>
</body>
</html>

