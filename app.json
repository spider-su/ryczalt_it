{
  "expo": {
    "name": "Investory Accounting",
    "slug": "smart-box",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "assets/brand/app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.investory.accounting",
      "icon": "assets/brand/app-icon.png"
    },
    "android": {
      "package": "pl.investory.accounting",
      "adaptiveIcon": {
        "foregroundImage": "assets/brand/adaptive-foreground.png",
        "backgroundColor": "#1769E0"
      }
    },
    "web": {
      "name": "Investory",
      "shortName": "Investory",
      "lang": "en",
      "themeColor": "#1769E0",
      "backgroundColor": "#F5F7FC",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "favicon": "public/favicon-48.png"
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FC"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Investory Accounting to use Face ID to unlock your account."
        }
      ],
      "expo-notifications",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "8fa28fb6-df62-4889-8e3a-8094de92bd59"
      }
    },
    "owner": "smart-box"
  }
}
