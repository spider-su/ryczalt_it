{
  "expo": {
    "name": "Investory Accounting",
    "slug": "smart-box",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.investory.accounting"
    },
    "android": {
      "package": "pl.investory.accounting"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Allow Investory Accounting to use Face ID to unlock your account." }],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "8fa28fb6-df62-4889-8e3a-8094de92bd59"
      }
    },
    "owner": "smart-box"
  }
}
